# .env.example — copy to .env and fill in. NEVER commit .env.
# All values validated at runtime; missing required vars fail loudly.

# --- REQUIRED: code-server password (you log in with this in the browser) ---
# Leave blank to auto-generate a strong random password on first autoconfig run
# (it will be printed once and saved to .env on the VM).
CODE_SERVER_PASSWORD=

# --- OPTIONAL: NVIDIA build.nvidia.com API key (for GLM, Nemotron, Kimi, DeepSeek, etc.) ---
# Get one at https://build.nvidia.com  (account -> API keys)
NVIDIA_API_KEY=

# --- OPTIONAL: Claude Code CLI auth token (for `claude` agent CLI on the VM) ---
# Generate via:  claude login   on your laptop, then copy the token, OR use the
# OAuth flow. Leave blank to run `claude login` interactively after first SSH.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Domain that will point at the VM (Cloudflare DNS A record you add manually) ---
DOMAIN=code.dmj.one

# --- Internal code-server port (Nginx fronts it on 443) ---
CODE_SERVER_PORT=8080

# --- Node version for the VM ---
NODE_VERSION=20

# --- VM provisioning (used by deploy/create-vm.sh, not by autoconfig.sh) ---
# Override when running create-vm.sh:
# VM_NAME=code-server
# ZONE=us-central1-a
# MACHINE_TYPE=e2-standard-2
# DISK_SIZE=50
