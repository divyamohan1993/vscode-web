# .env.example: copy to .env on the VM, fill in, then run autoconfig.sh.
# NEVER commit .env. autoconfig.sh reads this and writes it back mode 600.

# REQUIRED: code-server login password (you type this in the browser).
# Leave blank and autoconfig generates a strong one, prints it once, and
# saves it back to ~/.env so reruns reuse the same password.
CODE_SERVER_PASSWORD=

# Public hostname. Cloudflare A record points here (see README).
DOMAIN=vscode.dmj.one

# OPTIONAL: NVIDIA build.nvidia.com API key (GLM, Nemotron, Kimi K2, DeepSeek).
# Passed into the container environment. Get one at https://build.nvidia.com
NVIDIA_API_KEY=

# OPTIONAL: pre-auths the `claude` CLI inside the container. Leave blank to run
# `claude login` once in a code-server terminal instead (it persists in the volume).
CLAUDE_CODE_OAUTH_TOKEN=

# code-server's internal port. Caddy reaches the container on this port.
CODE_SERVER_PORT=8080

# OPTIONAL: integrate-mode container name. Caddy proxies to this name.
CONTAINER_NAME=vscode-web

# OPTIONAL: docker network to join. Blank auto-detects the front-door container's network.
FRONT_NET=

# OPTIONAL: front-door container. Blank auto-detects the container publishing :443.
CADDY_CONTAINER=

# OPTIONAL: Caddyfile host path. Blank reads it from the caddy container's mount.
CADDYFILE_PATH=

# standalone mode only:
# OPTIONAL: user to run code-server as. Blank defaults to the sudo caller.
CODE_SERVER_USER=
# Node major version installed in standalone mode.
NODE_VERSION=20
